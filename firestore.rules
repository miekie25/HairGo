rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // HELPER FUNCTIONS (small checks reused in the rules below)
    // ---------------------------------------------------------------

    // True if the person making the request is logged in.
    function isSignedIn() {
      return request.auth != null;
    }

    // True if the logged-in person is the exact user with this id.
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Looks up the logged-in person's role (client, owner, admin)
    // from their document in the users collection.
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // True if the logged-in person has the role "admin".
    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }

    // ---------------------------------------------------------------
    // USERS
    // ---------------------------------------------------------------
    match /users/{userId} {
      // Any logged-in user can read user profiles.
      allow read: if isSignedIn();
      // A user can only create their own profile.
      allow create: if isOwner(userId);
      // A user can update their own profile, or an admin can update any.
      allow update: if isOwner(userId) || isAdmin();
      // Nobody can permanently delete a user (the app uses soft delete).
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // SALONS
    // ---------------------------------------------------------------
    match /salons/{salonId} {
      // Any logged-in user can view salons.
      allow read: if isSignedIn();
      // Any logged-in user can create a salon.
      allow create: if isSignedIn();
      // The salon's owner or an admin can change anything.
      // Everyone else can change ONLY avgRating, which is recalculated
      // when a client leaves a review.
      allow update: if isSignedIn() && (
        resource.data.ownerID == request.auth.uid ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avgRating'])
      );
      // Nobody can permanently delete a salon.
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // BOOKINGS
    // ---------------------------------------------------------------
    match /bookings/{bookingId} {
      // Any logged-in user can read bookings.
      allow read: if isSignedIn();
      // A client can only create a booking in their own name.
      allow create: if isSignedIn() && request.resource.data.clientID == request.auth.uid;
      // A booking can be updated by the client who made it, an admin,
      // or the owner of the salon the booking is for.
      allow update: if isSignedIn() && (
        resource.data.clientID == request.auth.uid ||
        isAdmin() ||
        get(/databases/$(database)/documents/salons/$(resource.data.salonID)).data.ownerID == request.auth.uid
      );
      // Nobody can permanently delete a booking (cancelling is a soft delete).
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // SLOT LOCKS
    // One small record per salon and time slot. It names the booking
    // that is holding that slot, so two people cannot book the same
    // slot at the same moment (the booking runs as a transaction).
    // A lock is never deleted, only overwritten when a cancelled or
    // expired slot is booked again.
    // ---------------------------------------------------------------
    match /slotLocks/{slotId} {
      // Any logged-in user can read locks (needed to see taken slots).
      allow read: if isSignedIn();
      // Any logged-in user can create or overwrite a lock when booking.
      allow create, update: if isSignedIn();
      // Locks can never be deleted.
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // REVIEWS
    // ---------------------------------------------------------------
    match /reviews/{reviewId} {
      // Any logged-in user can read reviews.
      allow read: if isSignedIn();
      // A client can only write a review in their own name.
      allow create: if isSignedIn() && request.resource.data.clientID == request.auth.uid;
      // Only the client who wrote the review, or an admin, can edit it.
      allow update: if isSignedIn() && (resource.data.clientID == request.auth.uid || isAdmin());
      // Nobody can permanently delete a review.
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // MESSAGES
    // ---------------------------------------------------------------
    match /messages/{messageId} {
      // Only the sender, the recipient, or an admin can read a message.
      allow read: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.recipientUid == request.auth.uid ||
        isAdmin()
      );
      // A user can only send a message in their own name.
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      // Only an admin can edit or delete messages.
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // CONVERSATIONS (client-to-salon booking chat)
    // One document per booking (id = booking id) holding the preview,
    // plus a messages subcollection holding the actual chat.
    // ---------------------------------------------------------------
    match /conversations/{conversationId} {
      // Only the two participants of the booking may read the conversation.
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;

      // The conversation must belong to a real booking, and both the
      // clientId and ownerId must match that booking and its salon. This
      // stops anyone inventing a conversation between two other people.
      allow create: if isSignedIn()
        && request.resource.data.bookingId == conversationId
        && request.resource.data.clientId ==
             get(/databases/$(database)/documents/bookings/$(conversationId)).data.clientID
        && request.resource.data.salonId ==
             get(/databases/$(database)/documents/bookings/$(conversationId)).data.salonID
        && request.resource.data.ownerId ==
             get(/databases/$(database)/documents/salons/$(request.resource.data.salonId)).data.ownerID
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants == [
             get(/databases/$(database)/documents/bookings/$(conversationId)).data.clientID,
             get(/databases/$(database)/documents/salons/$(request.resource.data.salonId)).data.ownerID
           ];

      // A participant may only refresh the preview and unread flags when a
      // new message is sent - nothing else can be changed.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'lastMessage', 'lastMessageAt', 'lastMessageBy',
             'unreadClient', 'unreadOwner'
           ]);

      // Conversations are never deleted by the app.
      allow delete: if false;

      // The chat itself: participants only, and a message can only be sent
      // in the sender's own name, with a non-empty body of at most 1000 chars.
      //
      // These checks use getAfter() rather than get(). The very first message
      // is written in the SAME batch as the conversation document, and a plain
      // get() would read the state BEFORE that batch commits - so the
      // conversation would look missing and the first message would be denied.
      // getAfter() reads the conversation as it will be once the batch is
      // applied, so the first message and every later one both pass.
      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in
             getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        allow create: if isSignedIn()
          && request.auth.uid in
             getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;

        allow update, delete: if false;
      }
    }

    // ---------------------------------------------------------------
    // REPORTS
    // ---------------------------------------------------------------
    match /reports/{reportId} {
      // Any logged-in user can read reports.
      allow read: if isSignedIn();
      // Any logged-in user can submit a report.
      allow create: if isSignedIn();

      // An admin can change anything on a report.
      // The person who wrote the report can edit it only while its
      // status is still "pending", and only these fields: category,
      // severity, description, userEmail, screenshots, isEdited, updatedAt.
      allow update: if isAdmin() || (
        isOwner(resource.data.userID)
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'category', 'severity', 'description', 'userEmail',
             'screenshots', 'isEdited', 'updatedAt'
           ])
      );

      // Nobody can permanently delete a report.
      allow delete: if false;
    }
  }
}