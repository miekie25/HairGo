<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/home_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header with elevation -->
        <include
            android:id="@+id/header"
            layout="@layout/component_header"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Salon gradient hero -->
        <View
            android:id="@+id/gradientBackground"
            android:layout_width="0dp"
            android:layout_height="180dp"
            android:background="@drawable/bg_salon_header"
            app:layout_constraintTop_toBottomOf="@id/header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Circular salon photo -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivSalonPfp"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="80dp"
            android:elevation="6dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/salon_photo_desc"
            android:background="@drawable/bg_circle_teal_light"
            android:src="@drawable/ic_salon_placeholder"
            android:tint="@color/home_icon"
            android:padding="0dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.HairGo_Circle"
            app:strokeWidth="4dp"
            app:strokeColor="@color/salon_info_card_bg"
            app:layout_constraintTop_toBottomOf="@id/header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Progress bar (centered over PFP) -->
        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/home_icon"
            app:layout_constraintTop_toTopOf="@id/ivSalonPfp"
            app:layout_constraintBottom_toBottomOf="@id/ivSalonPfp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Content group (visible after load) -->
        <androidx.constraintlayout.widget.Group
            android:id="@+id/contentGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="invisible"
            app:constraint_referenced_ids="cardSalonName,tvNextAvailable,divider,tvServicesLabel,rvServices,llReviewsSection,btnBook,btnReportSalon"/>

        <!-- Salon name / location / rating card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSalonName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/home_border"
            app:cardBackgroundColor="@color/salon_info_card_bg"
            app:layout_constraintTop_toBottomOf="@id/ivSalonPfp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvSalonName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/salon_section_title"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <LinearLayout
                    android:id="@+id/llLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    app:layout_constraintTop_toBottomOf="@id/tvSalonName"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_location"
                        app:tint="@color/home_icon"/>

                    <TextView
                        android:id="@+id/tvSalonLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textColor="@color/home_text_secondary"
                        android:textSize="13sp"/>

                </LinearLayout>

                <!-- Rating badge (clickable, opens reviews) -->
                <TextView
                    android:id="@+id/tvSalonRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/salon_rating_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_home_rating_badge"
                    android:gravity="center"
                    android:drawableStart="@drawable/ic_star"
                    android:drawablePadding="5dp"
                    android:drawableTint="@color/salon_rating_text"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/see_all_reviews"
                    app:layout_constraintTop_toBottomOf="@id/llLocation"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Next available date -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tvNextAvailable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/salon_date_bg"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/cardSalonName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_calendar"
                    app:tint="@color/salon_date_text"
                    android:importantForAccessibility="no"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/salon_date_text"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Divider -->
        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="16dp"
            android:background="@color/home_border"
            app:layout_constraintTop_toBottomOf="@id/tvNextAvailable"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Services section header -->
        <TextView
            android:id="@+id/tvServicesLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="16dp"
            android:text="@string/section_services"
            android:textColor="@color/salon_section_title"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Services RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvServices"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="16dp"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/tvServicesLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Reviews section -->
        <LinearLayout
            android:id="@+id/llReviewsSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="16dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/rvServices"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginBottom="16dp"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_reviews"
                android:textColor="@color/salon_section_title"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <ProgressBar
                android:id="@+id/previewReviewsProgress"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/salon_accent"/>

            <TextView
                android:id="@+id/tvPreviewEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/no_reviews_yet"
                android:textColor="@color/home_text_secondary"
                android:textSize="14sp"
                android:visibility="gone"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvReviewPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:nestedScrollingEnabled="false"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/tvSeeAllReviews"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"
                android:paddingVertical="8dp"
                android:text="@string/see_all_reviews"
                android:textColor="@color/salon_accent"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"/>

        </LinearLayout>

        <!-- Book Now button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBook"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:layout_marginHorizontal="16dp"
            android:text="@string/btn_book_now"
            android:background="@drawable/bg_button_teal"
            style="@style/ButtonPrimary"
            app:layout_constraintTop_toBottomOf="@id/llReviewsSection"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Report Salon button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnReportSalon"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="24dp"
            android:text="@string/report_salon_action"
            style="@style/ButtonSecondaryOutline"
            app:layout_constraintTop_toBottomOf="@id/btnBook"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
