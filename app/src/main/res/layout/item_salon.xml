<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:clickable="true"
    android:focusable="true"
    app:rippleColor="@color/teal_light"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivSalonPhoto"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/salon_photo_desc"
            android:background="@drawable/bg_thumb_placeholder"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.HairGo_Thumb"
            app:srcCompat="@drawable/ic_salon_placeholder_teal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tvSalonName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/heading"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/ivSalonPhoto"
            app:layout_constraintStart_toEndOf="@id/ivSalonPhoto"
            app:layout_constraintEnd_toStartOf="@id/ivChevron"/>

        <ImageView
            android:id="@+id/ivLocationIcon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginTop="8dp"
            android:src="@drawable/ic_location"
            app:tint="@color/grey_medium"
            android:importantForAccessibility="no"
            app:layout_constraintTop_toBottomOf="@id/tvSalonName"
            app:layout_constraintStart_toStartOf="@id/tvSalonName"/>

        <TextView
            android:id="@+id/tvSalonLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/grey_medium"
            android:textSize="13sp"
            app:layout_constraintTop_toTopOf="@id/ivLocationIcon"
            app:layout_constraintBottom_toBottomOf="@id/ivLocationIcon"
            app:layout_constraintStart_toEndOf="@id/ivLocationIcon"
            app:layout_constraintEnd_toStartOf="@id/ivChevron"/>

        <TextView
            android:id="@+id/tvSalonRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/teal_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_rating_badge"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/ivLocationIcon"
            app:layout_constraintStart_toStartOf="@id/tvSalonName"/>

        <ImageView
            android:id="@+id/ivChevron"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/teal"
            android:importantForAccessibility="no"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>