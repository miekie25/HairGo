<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true"
    app:rippleColor="@color/teal_light"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/grey_border"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivSalonPhoto"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/salon_photo_desc"
            android:background="@drawable/bg_thumb_placeholder"
            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.HairGo_Thumb"
            app:srcCompat="@drawable/ic_salon_placeholder_teal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tvSalonName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/navy"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/ivSalonPhoto"
            app:layout_constraintStart_toEndOf="@id/ivSalonPhoto"
            app:layout_constraintEnd_toStartOf="@id/ivChevron"/>

        <ImageView
            android:id="@+id/ivLocationIcon"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginTop="6dp"
            android:src="@drawable/ic_location"
            app:tint="@color/grey_medium"
            android:importantForAccessibility="no"
            app:layout_constraintTop_toBottomOf="@id/tvSalonName"
            app:layout_constraintStart_toStartOf="@id/tvSalonName"/>

        <TextView
            android:id="@+id/tvSalonLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/grey_medium"
            android:textSize="13sp"
            app:layout_constraintTop_toTopOf="@id/ivLocationIcon"
            app:layout_constraintBottom_toBottomOf="@id/ivLocationIcon"
            app:layout_constraintStart_toEndOf="@id/ivLocationIcon"
            app:layout_constraintEnd_toStartOf="@id/ivChevron"/>

        <ImageView
            android:id="@+id/ivStarIcon"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginTop="6dp"
            android:src="@drawable/ic_star"
            app:tint="@color/warning"
            android:importantForAccessibility="no"
            app:layout_constraintTop_toBottomOf="@id/ivLocationIcon"
            app:layout_constraintStart_toStartOf="@id/tvSalonName"/>

        <TextView
            android:id="@+id/tvSalonRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="@color/grey_dark"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/ivStarIcon"
            app:layout_constraintBottom_toBottomOf="@id/ivStarIcon"
            app:layout_constraintStart_toEndOf="@id/ivStarIcon"/>

        <ImageView
            android:id="@+id/ivChevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/grey_medium"
            android:importantForAccessibility="no"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>