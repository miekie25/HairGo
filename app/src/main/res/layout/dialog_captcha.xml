<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Security Verification"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/heading"
        android:gravity="center"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tvCaptchaPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select 2 images"
        android:textSize="13sp"
        android:textColor="@color/grey_medium"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- 2 rows x 3 columns grid for 6 images -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="2"
        android:alignmentMode="alignMargins"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp">

        <!-- Slot 1 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card1"
            android:layout_width="0dp"
            android:layout_height="95dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:cardCornerRadius="10dp"
            app:strokeColor="@color/grey_border"
            app:strokeWidth="1dp"
            app:cardElevation="0dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/iv1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Slot 2 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card2"
            android:layout_width="0dp"
            android:layout_height="95dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:cardCornerRadius="10dp"
            app:strokeColor="@color/grey_border"
            app:strokeWidth="1dp"
            app:cardElevation="0dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/iv2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Slot 3 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card3"
            android:layout_width="0dp"
            android:layout_height="95dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:cardCornerRadius="10dp"
            app:strokeColor="@color/grey_border"
            app:strokeWidth="1dp"
            app:cardElevation="0dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/iv3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Slot 4 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card4"
            android:layout_width="0dp"
            android:layout_height="95dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:cardCornerRadius="10dp"
            app:strokeColor="@color/grey_border"
            app:strokeWidth="1dp"
            app:cardElevation="0dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/iv4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Slot 5 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card5"
            android:layout_width="0dp"
            android:layout_height="95dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:cardCornerRadius="10dp"
            app:strokeColor="@color/grey_border"
            app:strokeWidth="1dp"
            app:cardElevation="0dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/iv5"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Slot 6 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card6"
            android:layout_width="0dp"
            android:layout_height="95dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:cardCornerRadius="10dp"
            app:strokeColor="@color/grey_border"
            app:strokeWidth="1dp"
            app:cardElevation="0dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView
                android:id="@+id/iv6"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>
        </com.google.android.material.card.MaterialCardView>

    </GridLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerifyCaptcha"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Verify"
        android:textAllCaps="false"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/navy"
        android:layout_marginBottom="6dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelCaptcha"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="Cancel"
        android:textAllCaps="false"
        style="@style/Widget.Material3.Button.TextButton"
        android:textColor="@color/grey_medium"/>

</LinearLayout>