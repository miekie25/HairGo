<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:orientation="vertical">

    <!-- Filter & Sort Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <!-- User search -->
        <LinearLayout
            android:id="@+id/llUserSearchBar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_home_search_pill"
            android:addStatesFromChildren="true"
            android:outlineProvider="background"
            android:paddingHorizontal="16dp"
            android:elevation="4dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                android:importantForAccessibility="no"
                app:tint="@color/home_icon"/>

            <EditText
                android:id="@+id/etUserSearch"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@android:color/transparent"
                android:hint="@string/hint_search_users"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:singleLine="true"
                android:gravity="center_vertical"
                android:paddingVertical="0dp"
                android:includeFontPadding="false"
                android:textColor="@color/home_search_text"
                android:textColorHint="@color/home_search_hint"
                android:textSize="15sp"/>

        </LinearLayout>

        <!-- Role Filter Toggles -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleGroupUserRole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterAllUsers"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="@string/admin_filter_all"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:strokeColor="@color/navy" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterClients"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="@string/admin_filter_clients"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:strokeColor="@color/grey_border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterSalons"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="@string/admin_filter_owners"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:strokeColor="@color/grey_border" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFilterAdmins"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="@string/admin_filter_admins"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:strokeColor="@color/grey_border" />

            </com.google.android.material.button.MaterialButtonToggleGroup>
        </HorizontalScrollView>

        <!-- Sort Option Spinner/Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="@string/admin_sort_by"
                android:textColor="@color/heading"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUserSortOption"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="@string/admin_sort_date_newest"
                android:textAllCaps="false"
                android:textColor="@color/navy"
                android:textSize="13sp"
                android:textStyle="bold" />
        </RelativeLayout>

    </LinearLayout>

    <!-- Users List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvUsers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyUsers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="32dp"
        android:text="@string/admin_users_empty"
        android:textColor="@color/grey_medium"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>