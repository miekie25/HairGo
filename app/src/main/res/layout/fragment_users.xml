<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey_light"
    android:orientation="vertical">

    <!-- Filter & Sort Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <!-- Role Filter Toggles -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroupUserRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterAllUsers"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="All"
                android:textAllCaps="false"
                android:textSize="12.5sp"
                app:strokeColor="@color/navy" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterClients"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Clients"
                android:textAllCaps="false"
                android:textSize="12.5sp"
                app:strokeColor="@color/grey_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterSalons"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Salon Owners"
                android:textAllCaps="false"
                android:textSize="12.5sp"
                app:strokeColor="@color/grey_border" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Sort Option Spinner/Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Sort by:"
                android:textColor="@color/heading"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUserSortOption"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Date: Newest First ▾"
                android:textAllCaps="false"
                android:textColor="@color/navy"
                android:textSize="13sp"
                android:textStyle="bold" />
        </RelativeLayout>

    </LinearLayout>

    <!-- Users List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvUsers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyUsers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="32dp"
        android:text="No users found"
        android:textColor="@color/grey_medium"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>