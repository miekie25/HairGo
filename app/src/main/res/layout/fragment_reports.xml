<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey_light"
    android:orientation="vertical">

    <!-- Top Filter Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <!-- Status Filter Toggles -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroupStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterPending"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Incoming"
                android:textAllCaps="false"
                android:textSize="12.5sp"
                app:strokeColor="@color/navy" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterReviewed"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Reviewed"
                android:textAllCaps="false"
                android:textSize="12.5sp"
                app:strokeColor="@color/grey_border" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterDismissed"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Dismissed"
                android:textAllCaps="false"
                android:textSize="12.5sp"
                app:strokeColor="@color/grey_border" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Sorting Selector -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Sort by Date:"
                android:textColor="@color/heading"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReportSortOrder"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Oldest First ▴"
                android:textAllCaps="false"
                android:textColor="@color/navy"
                android:textSize="13sp"
                android:textStyle="bold" />
        </RelativeLayout>

    </LinearLayout>

    <!-- RecyclerView for Reports -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvReports"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <!-- Empty State Text -->
    <TextView
        android:id="@+id/tvEmptyReports"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="32dp"
        android:text="No reports found"
        android:textColor="@color/grey_medium"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>