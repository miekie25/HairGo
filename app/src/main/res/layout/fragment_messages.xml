<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/home_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_home_header"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="30dp">

        <TextView
            android:id="@+id/tvMessagesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_messages"
            android:textColor="@color/home_header_text"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvMessagesSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/messages_subtitle"
            android:textColor="@color/home_header_subtext"
            android:textSize="13sp"/>

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvConversations"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="10dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            android:scrollbars="none"/>

        <TextView
            android:id="@+id/tvMessagesEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="32dp"
            android:padding="24dp"
            android:drawableTop="@drawable/ic_messages_empty"
            android:drawablePadding="16dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/messages_empty"
            android:textColor="@color/home_text_secondary"
            android:textSize="14sp"
            android:visibility="gone"/>

    </FrameLayout>

</LinearLayout>
