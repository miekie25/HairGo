<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ButtonPrimary" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_teal</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:layout_height">56dp</item>
    </style>

    <style name="ButtonSecondary" parent="Widget.AppCompat.Button">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textColor">@color/teal</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="ButtonDangerOutline" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_outline_error</item>
        <item name="android:textColor">@color/error</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:layout_height">56dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.HairGo_Thumb" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <!-- All Snackbars in the app: navy pill, white text, rounded corners. -->
    <style name="Widget.HairGo.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/navy</item>
        <item name="android:textColor">@color/white</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.HairGo_Snackbar</item>
    </style>

    <style name="ShapeAppearanceOverlay.HairGo_Snackbar" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

</resources>
