<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- REQUIRED for Firebase and your PHP REST API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Runtime-requested on Android 13+ so booking notifications can be shown. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".HairGoApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HairGo">

        <!-- LAUNCHER: Splash screen opens first -->
        <activity
            android:name=".activities.SplashActivity"
            android:theme="@style/Theme.HairGo.Splash"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Core app screens -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false" />

        <activity
            android:name=".activities.WelcomeActivity"
            android:exported="false" />

        <activity
            android:name=".activities.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".activities.ForgotPasswordActivity"
            android:exported="false" />

        <!-- Registration flow -->
        <activity
            android:name=".activities.RoleSelectionActivity"
            android:exported="false" />

        <activity
            android:name=".activities.RegisterClientActivity"
            android:exported="false" />

        <activity
            android:name=".activities.RegisterOwnerActivity"
            android:exported="false" />

        <activity
            android:name=".activities.OtpVerificationActivity"
            android:exported="false" />

        <activity
            android:name=".activities.TermsConditionsActivity"
            android:exported="false" />

        <!-- Post-login screens: client -->
        <activity
            android:name=".activities.ClientDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".activities.SalonProfileActivity"
            android:exported="false" />

        <activity
            android:name=".activities.BookAppointmentActivity"
            android:exported="false" />

        <activity
            android:name=".activities.BookingDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".activities.MyReportsActivity"
            android:exported="false" />

        <activity
            android:name=".activities.NotificationsActivity"
            android:exported="false" />

        <!-- Post-login screens: owner -->
        <activity
            android:name=".activities.OwnerDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".activities.OwnerBookingDetailsActivity"
            android:exported="false" />

        <!-- Admin -->
        <activity
            android:name=".activities.AdminDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".activities.ReportDetailActivity"
            android:exported="false" />

        <activity
            android:name=".activities.SendMessageActivity"
            android:exported="false" />

        <!-- Client-to-salon booking chat -->
        <activity
            android:name=".activities.ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Push notifications -->
        <service
            android:name=".notifications.HairGoMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Channel used for messages received while the app is in the background -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="hairgo_updates" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_bell" />

        <activity android:name=".activities.PhotoViewerActivity" android:exported="false" />

    </application>

</manifest>
